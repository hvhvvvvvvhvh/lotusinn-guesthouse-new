# Admin panel credentials
# Change these before deploying publicly.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional Supabase migration. The live app currently uses local JSON storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional writable directories; defaults are ./data and ./public/data.
# Use one Node process with local JSON storage. Back up both directories.
# LOTUS_DATA_DIR=C:/path/to/private-data
# LOTUS_PUBLIC_DATA_DIR=C:/path/to/public-data
