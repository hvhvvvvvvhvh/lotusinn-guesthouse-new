# Admin panel credentials
# Change these before deploying publicly.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Use json for local-only development, supabase for persistent hosting.
LOTUS_STORAGE_DRIVER=supabase
# Project URL from Supabase Project Settings / Data API.
SUPABASE_URL=
# Server secret key (sb_secret_...) or legacy service_role key. Never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Optional writable directories; defaults are ./data and ./public/data.
# Only applies to json mode or the initial import. Back up both directories.
# LOTUS_DATA_DIR=C:/path/to/private-data
# LOTUS_PUBLIC_DATA_DIR=C:/path/to/public-data
